USE magist;
-- 1

-- tech category 
SELECT DISTINCT
  product_category_name AS tech_category
FROM products
WHERE product_category_name IN (
  'computer_accessories',
  'electronic',
  'console_games',
  'air_conditioning',
  'audio',
  'computers',
  'music',
  'tablets_printing_image',
  'pc_gamer',
  'telephony',
  'fixed_telephony',
  'dvds_blu_ray')



ORDER BY product_category_name;

WITH classified_products AS (
  SELECT
    oi.*,
    CASE
      WHEN p.product_category_name IN (
        'computer_accessories',
        'electronic',
        'console_games',
        'air_conditioning',
        'audio',
        'computers',
        'music',
        'tablets_printing_image',
        'pc_gamer',
        'telephony',
        'fixed_telephony',
        'dvds_blu_ray'
      ) THEN 'Tech'
      ELSE 'Non‑tech'
    END AS category_group
  FROM order_items oi
  JOIN products p ON oi.product_id = p.product_id
)


-- products sold , pct
SELECT
  category_group,
  COUNT(*) AS products_sold,
  ROUND(
    100.0 * COUNT(*) / SUM(COUNT(*)) OVER (),
    2
  ) AS pct_of_total_sold
FROM classified_products
GROUP BY category_group;


-- avg price all products
SELECT
  AVG(oi.price) AS avg_price_all_products
FROM order_items oi
JOIN products p ON oi.product_id = p.product_id;


-- is tech product expensive, units sold, pct

WITH tech_products AS (
  SELECT
    oi.*,
    p.product_category_name,
    CASE
      WHEN p.product_category_name IN (
        'computer_accessories',
        'electronic',
        'console_games',
        'air_conditioning',
        'audio',
        'computers',
        'music',
        'tablets_printing_image',
        'pc_gamer',
        'telephony',
        'fixed_telephony',
        'dvds_blu_ray'
      ) THEN 'Tech'
      ELSE 'Non‑tech'
    END AS category_group
  FROM order_items oi
  JOIN products p ON oi.product_id = p.product_id
),
tech_price_bands AS (
  SELECT
    *,
    CASE
      WHEN price < 50 THEN 'Cheap'
      WHEN price < 200 THEN 'Medium'
      ELSE 'Expensive'
    END AS price_band
  FROM tech_products
  WHERE category_group = 'Tech'
)
SELECT
  price_band,
  COUNT(*) AS units_sold,
  ROUND(
    100.0 * COUNT(*) / SUM(COUNT(*)) OVER (),
    2
  ) AS pct_of_tech_sold
FROM tech_price_bands
GROUP BY price_band
ORDER BY units_sold DESC;


