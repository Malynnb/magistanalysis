-- First, get how many months of data
SELECT 
  COUNT(DISTINCT DATE_FORMAT(order_purchase_timestamp, '%Y-%m')) AS months_count
FROM orders;

-- Then, average monthly income for all sellers
SELECT 
  SUM(oi.price + oi.freight_value) / 
    (SELECT COUNT(DISTINCT DATE_FORMAT(order_purchase_timestamp, '%Y-%m')) 
     FROM orders
    ) AS avg_monthly_earnings_all_sellers
FROM order_items oi;


-- Average monthly income for Tech sellers
SELECT 
  SUM(oi.price + oi.freight_value) / 
    (SELECT COUNT(DISTINCT DATE_FORMAT(order_purchase_timestamp, '%Y-%m')) 
     FROM orders
    ) AS avg_monthly_earnings_tech_sellers
FROM order_items oi
JOIN products p ON oi.product_id = p.product_id
WHERE p.product_category_name IN (
  'computer_accessories',
  'electronic',
  'console_games',
  'air_conditioning',
  'audio',
  'computers',
  'music',
  'tablets_printing_image',
  'pc_gamer',
  'telephony',
  'fixed_telephony',
  'dvds_blu_ray'
);

WITH product_groups AS (
  SELECT
    o.order_id,
    o.order_delivered_customer_date,
    o.order_estimated_delivery_date,
    CASE
      WHEN p.product_category_name IN (
        'bed_bath_table',
        'furniture_decor',
        'home_comfort2',
        'sofa_mattress'
      ) THEN 'Big products'
      WHEN p.product_category_name IN (
        'computers',
        'electronics',
        'telephony',
        'audio',
        'tablets_printing_image'
      ) THEN 'Tech products'
      ELSE 'Small products'
    END AS product_group
  FROM orders o
  JOIN order_items oi ON o.order_id = oi.order_id
  JOIN products p ON oi.product_id = p.product_id
  WHERE o.order_delivered_customer_date IS NOT NULL
)
SELECT
  product_group,
  COUNT(*) AS order_count,
  AVG(
    DATEDIFF(order_delivered_customer_date, order_estimated_delivery_date)
  ) AS avg_delay_days,
  ROUND(
    100.0 * SUM(
      CASE
        WHEN order_delivered_customer_date > order_estimated_delivery_date
          THEN 1 ELSE 0
      END
    ) / COUNT(*),
    2
  ) AS delay_pct
FROM product_groups
GROUP BY product_group
ORDER BY product_group;

